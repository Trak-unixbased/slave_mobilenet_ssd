#include "rknn_opencv.h"

#include <cstdio>
#include <cstring>
#include <system_error>

static const std::chrono::milliseconds con_var_time_out(100);

rknn_opencv::rknn_opencv(unsigned int slot_count)
	: slots(slot_count < 2 ? 2 : slot_count),
	  is_running(false), capture_done(false), detect_done(false),
	  last_error(0), drop_frames(true),
	  next_frame_id(0), dropped_frames(0),
	  fps(0.0f), frame_count(0),
	  last_time(std::chrono::steady_clock::now()),
	  user_ctx_ptr(nullptr),
	  get_img_func(nullptr), detect_img_func(nullptr),
	  show_img_func(nullptr)
{
	for (auto &slot : slots) {
		memset(&slot.out_data, 0, sizeof(slot.out_data));
		slot.frame_id = 0;
		idle_queue.push_back(&slot);
	}
}

rknn_opencv::~rknn_opencv()
{
	stop();
}

void rknn_opencv::get_img_task(void)
{
	int ret;

	while (is_running) {
		rknn_queue_data *img = nullptr;

		{
			std::unique_lock<std::mutex> lock(mtx);

			if (!idle_queue.empty()) {
				img = idle_queue.front();
				idle_queue.pop_front();
			} else if (drop_frames && !input_queue.empty()) {
				/* NPU is behind: reuse the stalest pending frame */
				img = input_queue.front();
				input_queue.pop_front();
				dropped_frames++;
			} else {
				cond_idle.wait_for(lock, con_var_time_out);
				continue;
			}
		}

		ret = (*get_img_func)(user_ctx_ptr, img->img_origin,
				      img->img_resize);

		std::lock_guard<std::mutex> lock(mtx);

		if (ret != 0) {
			idle_queue.push_back(img);
			if (ret < 0) {
				fprintf(stderr, "get_img error [%d], stopping\n",
					ret);
				int expected = 0;
				last_error.compare_exchange_strong(expected, ret);
				is_running = false;
			}
			break;
		}

		img->frame_id = next_frame_id++;
		input_queue.push_back(img);
		cond_input.notify_one();
	}

	{
		std::lock_guard<std::mutex> lock(mtx);
		capture_done = true;
	}
	cond_input.notify_all();
	cond_output.notify_all();
}

void rknn_opencv::detect_img_task(void)
{
	int ret;

	while (is_running) {
		rknn_queue_data *img = nullptr;

		{
			std::unique_lock<std::mutex> lock(mtx);

			cond_input.wait_for(lock, con_var_time_out, [this] {
				return !input_queue.empty() || capture_done ||
				       !is_running;
			});

			if (!is_running)
				break;

			if (input_queue.empty()) {
				if (capture_done)
					break;	/* drained */
				continue;
			}

			img = input_queue.front();
			input_queue.pop_front();
		}

		ret = (*detect_img_func)(user_ctx_ptr, img->img_resize,
					 &img->out_data);

		std::lock_guard<std::mutex> lock(mtx);

		if (ret < 0) {
			fprintf(stderr, "detect_img error [%d], stopping\n", ret);
			int expected = 0;
			last_error.compare_exchange_strong(expected, ret);
			is_running = false;
			idle_queue.push_back(img);
			cond_idle.notify_all();
			break;
		}

		output_queue.push_back(img);
		cond_output.notify_one();
	}

	{
		std::lock_guard<std::mutex> lock(mtx);
		detect_done = true;
	}
	cond_output.notify_all();
	cond_idle.notify_all();
}

int rknn_opencv::start(rknn_get_img_fn get_img, rknn_detect_img_fn detect_img,
		       rknn_show_img_fn show_img, void *user_ctx,
		       const std::vector<uint32_t> &out_sizes, bool drop)
{
	if (!get_img || !detect_img || !show_img)
		return -1;
	if (out_sizes.empty() || out_sizes.size() > RKNN_MAX_OUTPUTS) {
		fprintf(stderr, "unsupported number of outputs: %zu (max %d)\n",
			out_sizes.size(), RKNN_MAX_OUTPUTS);
		return -1;
	}
	if (is_running || thread_get_img.joinable() ||
	    thread_detect_img.joinable())
		return -1;

	/* allocate every output buffer once, reused for the whole run */
	for (auto &slot : slots) {
		memset(&slot.out_data, 0, sizeof(slot.out_data));
		for (size_t i = 0; i < out_sizes.size(); i++) {
			const size_t n = (out_sizes[i] + sizeof(float) - 1) /
					 sizeof(float);
			slot.storage[i].assign(n, 0.0f);
			slot.out_data.out[i] = slot.storage[i].data();
			slot.out_data.size[i] = out_sizes[i];
		}
		slot.out_data.count = static_cast<uint32_t>(out_sizes.size());
	}

	get_img_func = get_img;
	detect_img_func = detect_img;
	show_img_func = show_img;
	user_ctx_ptr = user_ctx;
	drop_frames = drop;

	capture_done = false;
	detect_done = false;
	last_error = 0;
	is_running = true;
	frame_count = 0;
	last_time = std::chrono::steady_clock::now();

	try {
		thread_get_img = std::thread(&rknn_opencv::get_img_task, this);
		thread_detect_img = std::thread(&rknn_opencv::detect_img_task,
						this);
	} catch (const std::system_error &e) {
		fprintf(stderr, "cannot create thread: %s\n", e.what());
		stop();
		return -1;
	}

	return 0;
}

int rknn_opencv::update_show(void)
{
	int ret;
	rknn_queue_data *img = nullptr;

	{
		std::unique_lock<std::mutex> lock(mtx);

		cond_output.wait_for(lock, con_var_time_out, [this] {
			return !output_queue.empty() || detect_done ||
			       !is_running;
		});

		if (output_queue.empty())
			return (detect_done || !is_running) ? -1 : 0;

		img = output_queue.front();
		output_queue.pop_front();
	}

	frame_count++;
	const auto cur_time = std::chrono::steady_clock::now();
	const float elapsed =
		std::chrono::duration<float>(cur_time - last_time).count();
	if (elapsed >= 1.0f) {
		fps = static_cast<float>(frame_count) / elapsed;
		last_time = cur_time;
		frame_count = 0;
	}

	ret = (*show_img_func)(user_ctx_ptr, img->img_origin, fps,
			       &img->out_data);

	{
		std::lock_guard<std::mutex> lock(mtx);
		idle_queue.push_back(img);
	}
	cond_idle.notify_one();

	return ret < 0 ? ret : 1;
}

int rknn_opencv::stop(void)
{
	{
		std::lock_guard<std::mutex> lock(mtx);
		is_running = false;
	}

	cond_idle.notify_all();
	cond_input.notify_all();
	cond_output.notify_all();

	/* the capture thread may sit in a blocking read for one frame period */
	if (thread_get_img.joinable())
		thread_get_img.join();
	if (thread_detect_img.joinable())
		thread_detect_img.join();

	/* give every slot back so the object can be restarted */
	std::lock_guard<std::mutex> lock(mtx);
	idle_queue.clear();
	input_queue.clear();
	output_queue.clear();
	for (auto &slot : slots)
		idle_queue.push_back(&slot);

	return 0;
}
