#ifndef RKNN_OPENCV_H
#define RKNN_OPENCV_H

#include <atomic>
#include <chrono>
#include <condition_variable>
#include <cstdint>
#include <deque>
#include <mutex>
#include <thread>
#include <vector>

#include <opencv2/core.hpp>

#define RKNN_MAX_OUTPUTS 8

/* Pipeline end codes returned by the get_img callback. */
#define RKNN_PIPE_EOF   1	/* end of stream: drain and stop, not an error */

/* Inference results of one frame. Buffers are owned by the pipeline. */
struct rknn_out_data {
	float *out[RKNN_MAX_OUTPUTS];
	uint32_t size[RKNN_MAX_OUTPUTS];	/* bytes */
	uint32_t count;
};

struct rknn_queue_data {
	cv::Mat img_origin;		/* frame as captured (BGR), drawn on */
	cv::Mat img_resize;		/* network input (RGB, model size)   */
	uint64_t frame_id;
	struct rknn_out_data out_data;
	std::vector<float> storage[RKNN_MAX_OUTPUTS];
};

/*
 * get_img:    fill origin/resize. Returns 0, RKNN_PIPE_EOF or < 0 on error.
 * detect_img: run the network on resize, fill out_data. Returns 0 or < 0.
 * show_img:   consume one result (main thread). Returns 0 or < 0.
 */
typedef int (*rknn_get_img_fn)(void *ctx, cv::Mat &origin, cv::Mat &resize);
typedef int (*rknn_detect_img_fn)(void *ctx, cv::Mat &resize,
				  struct rknn_out_data *out_data);
typedef int (*rknn_show_img_fn)(void *ctx, cv::Mat &origin, float fps,
				struct rknn_out_data *out_data);

/*
 * Three stage pipeline:
 *   capture thread -> input queue -> NPU thread -> output queue -> caller
 *
 * With drop_frames (live cameras) the capture thread recycles the oldest
 * frame still waiting for the NPU instead of queueing behind it, so the
 * latency stays at about one frame whatever the NPU speed. Without it (video
 * files) every frame is processed.
 */
class rknn_opencv {
private:
	std::vector<rknn_queue_data> slots;
	std::deque<rknn_queue_data *> idle_queue;
	std::deque<rknn_queue_data *> input_queue;
	std::deque<rknn_queue_data *> output_queue;

	std::mutex mtx;
	std::condition_variable cond_idle;
	std::condition_variable cond_input;
	std::condition_variable cond_output;

	std::atomic<bool> is_running;
	std::atomic<bool> capture_done;
	std::atomic<bool> detect_done;
	std::atomic<int> last_error;
	bool drop_frames;

	uint64_t next_frame_id;
	std::atomic<uint64_t> dropped_frames;

	float fps;
	int frame_count;
	std::chrono::steady_clock::time_point last_time;

	void *user_ctx_ptr;
	rknn_get_img_fn get_img_func;
	rknn_detect_img_fn detect_img_func;
	rknn_show_img_fn show_img_func;

	std::thread thread_get_img;
	std::thread thread_detect_img;

	void get_img_task(void);
	void detect_img_task(void);

public:
	explicit rknn_opencv(unsigned int slot_count = 4);
	~rknn_opencv();

	rknn_opencv(const rknn_opencv &) = delete;
