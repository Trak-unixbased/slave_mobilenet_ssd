### `packaging/udev/60-rk1808-npu.rules` (nouveau)
```
# Rockchip RK1808 AI compute stick (USB vendor 0x2207).
#  - group plugdev (used by npu-transfer-proxy.service) instead of world 0666
#  - uaccess: the logged-in desktop user also gets access
#  - plugging the stick starts npu-transfer-proxy.service if it is stopped
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="2207", \
  MODE="0660", GROUP="plugdev", TAG+="uaccess", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}+="npu-transfer-proxy.service"
```

### `packaging/debian/postinst`
```sh
#!/bin/sh
set -e

UNIT=npu-transfer-proxy.service

case "$1" in
configure)
	if [ -d /run/udev ] && command -v udevadm >/dev/null 2>&1; then
		udevadm control --reload-rules || true
		# re-apply permissions to a stick that is already plugged in
		udevadm trigger --action=change --subsystem-match=usb \
			--attr-match=idVendor=2207 || true
	fi
	;;
abort-upgrade|abort-remove|abort-deconfigure)
	;;
*)
	echo "postinst called with unknown argument '$1'" >&2
	exit 1
	;;
esac

# Same logic as dh_installsystemd: enable on first install, keep the admin's
# choice on upgrade, (re)start the proxy.
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || \
   [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		deb-systemd-helper unmask "$UNIT" >/dev/null || true
		if deb-systemd-helper --quiet was-enabled "$UNIT"; then
			deb-systemd-helper enable "$UNIT" >/dev/null || true
		else
			deb-systemd-helper update-state "$UNIT" >/dev/null || true
		fi
	fi

	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
		if [ -n "$2" ]; then
			_action=restart
		else
			_action=start
		fi
		deb-systemd-invoke "$_action" "$UNIT" >/dev/null || true
	fi
fi

exit 0
```

