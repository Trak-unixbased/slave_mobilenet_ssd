unsigned long rknn_test::get_time(void)
{
	using namespace std::chrono;
	return static_cast<unsigned long>(duration_cast<milliseconds>(
		steady_clock::now().time_since_epoch()).count());
}

/* ------------------------------------------------------------------------ */
/* Video source                                                             */
/* ------------------------------------------------------------------------ */

static bool is_number(const std::string &s)
{
	if (s.empty())
		return false;
	for (unsigned char c : s)
		if (!isdigit(c))
			return false;
	return true;
}

std::string rknn_test::find_camera(void)
{
	/*
	 * On a Raspberry Pi 5, /dev/video0..7 belong to the RP1 CFE / PiSP
	 * (raw Bayer, unusable by OpenCV), and on the Orange Pi 6 Plus the low
	 * nodes belong to the VPU/ISP. Pick the first UVC camera instead of
	 * blindly opening index 0.
	 */
	static const char *const skip_drivers[] = {
		"rp1-cfe", "pispbe", "bcm2835-isp", "bcm2835-codec",
		"unicam", "rpi-hevc-dec", "hantro-vpu",
	};
	std::string fallback;

	for (int i = 0; i < 64; i++) {
		char path[32];
		struct v4l2_capability vcap;

		snprintf(path, sizeof(path), "/dev/video%d", i);
		int fd = open(path, O_RDWR | O_NONBLOCK | O_CLOEXEC);
		if (fd < 0)
			continue;

		memset(&vcap, 0, sizeof(vcap));
		int r = ioctl(fd, VIDIOC_QUERYCAP, &vcap);
		close(fd);
		if (r < 0)
			continue;

		uint32_t caps = (vcap.capabilities & V4L2_CAP_DEVICE_CAPS) ?
				vcap.device_caps : vcap.capabilities;
		if (!(caps & V4L2_CAP_VIDEO_CAPTURE) ||
		    !(caps & V4L2_CAP_STREAMING) ||
		    (caps & (V4L2_CAP_VIDEO_M2M | V4L2_CAP_VIDEO_M2M_MPLANE)))
			continue;

		const char *drv = reinterpret_cast<const char *>(vcap.driver);
		if (strcmp(drv, "uvcvideo") == 0)
			return path;

		bool skip = false;
		for (size_t k = 0; k < ARRAY_SIZE(skip_drivers); k++)
			if (strcmp(drv, skip_drivers[k]) == 0)
				skip = true;
		if (!skip && fallback.empty())
			fallback = path;
	}

	return fallback;
}

int rknn_test::open_source(const rknn_run_options &opt)
{
	std::string src = opt.source;
	bool v4l2 = false;

	if (src.empty()) {
		src = find_camera();
		if (src.empty()) {
			fprintf(stderr,
				"no usable V4L2 camera found, use --source "
				"(device, file or GStreamer pipeline)\n");
			return -1;
		}
		printf("using camera %s\n", src.c_str());
	}

	live_source = true;

	if (src.find('!') != std::string::npos) {
		/* e.g. "libcamerasrc ! video/x-raw,width=640,height=480,format=BGR ! appsink drop=1" */
		cap.open(src, cv::CAP_GSTREAMER);
	} else if (is_number(src)) {
		cap.open(atoi(src.c_str()), cv::CAP_V4L2);
		v4l2 = true;
	} else if (src.rfind("/dev/video", 0) == 0) {
		cap.open(src, cv::CAP_V4L2);
		v4l2 = true;
	} else {
		cap.open(src, cv::CAP_ANY);
		/* network streams are live, local files are not */
		live_source = src.find("://") != std::string::npos;
	}

	if (!cap.isOpened()) {
		fprintf(stderr, "cannot open video source [%s]\n", src.c_str());
		return -1;
	}

	if (v4l2) {
		if (opt.mjpg)
			cap.set(cv::CAP_PROP_FOURCC,
				cv::VideoWriter::fourcc('M', 'J', 'P', 'G'));
		if (opt.cap_width > 0 && opt.cap_height > 0) {
			cap.set(cv::CAP_PROP_FRAME_WIDTH, opt.cap_width);
			cap.set(cv::CAP_PROP_FRAME_HEIGHT, opt.cap_height);
		}
		/* keep latency low: never queue old frames in the driver */
		cap.set(cv::CAP_PROP_BUFFERSIZE, 1);
	}

	source_fps = cap.get(cv::CAP_PROP_FPS);
	if (!(source_fps > 0.0 && source_fps <= 240.0))
		source_fps = 25.0;

	printf("source [%s]: %dx%d @ %.1f fps (%s)\n", src.c_str(),
	       static_cast<int>(cap.get(cv::CAP_PROP_FRAME_WIDTH)),
	       static_cast<int>(cap.get(cv::CAP_PROP_FRAME_HEIGHT)),
	       source_fps, cap.getBackendName().c_str());

	return 0;
}

/* ------------------------------------------------------------------------ */
/* Pipeline callbacks                                                       */
/* ------------------------------------------------------------------------ */

int rknn_test::get_img(void *ctx, cv::Mat &origin, cv::Mat &resize)
{
	rknn_test *test_ctx = static_cast<rknn_test *>(ctx);

	if (stop_requested)
		return RKNN_PIPE_EOF;

	/* read() reuses origin's buffer when the size does not change */
	if (!test_ctx->cap.read(origin) || origin.empty())
		return test_ctx->live_source ? -1 : RKNN_PIPE_EOF;

	const cv::Size net_size(test_ctx->img_width, test_ctx->img_height);

	/* resize first, then convert colours on the small image only */
	if (origin.size() != net_size)
		cv::resize(origin, resize, net_size, 0, 0, cv::INTER_LINEAR);
	else
		origin.copyTo(resize);

	switch (resize.channels()) {
	case 1:
		cv::cvtColor(resize, resize, cv::COLOR_GRAY2RGB);
		break;
	case 4:
		cv::cvtColor(resize, resize, cv::COLOR_BGRA2RGB);
		break;
	default:
		cv::cvtColor(resize, resize, cv::COLOR_BGR2RGB);
		break;
	}

	return 0;
}

int rknn_test::detect_img(void *ctx, cv::Mat &img,
			  struct rknn_out_data *out_data)
{
	int ret;
	rknn_test *test_ctx = static_cast<rknn_test *>(ctx);
	const size_t expected = static_cast<size_t>(test_ctx->img_width) *
				test_ctx->img_height * test_ctx->img_channels;

	if (img.empty() || !img.isContinuous() ||
	    img.total() * img.elemSize() != expected) {
		fprintf(stderr, "unexpected network input buffer\n");
		return -1;
	}

	const unsigned long start_time = get_time();

	ret = test_ctx->rknn_api.set_input(test_ctx->input_index, img.data,
					   static_cast<uint32_t>(expected));
	if (ret < 0) {
		fprintf(stderr, "rknn_inputs_set failed! ret=%d\n", ret);
		return ret;
	}

	ret = test_ctx->rknn_api.run(nullptr);
	if (ret < 0) {
		fprintf(stderr, "rknn_run failed! ret=%d\n", ret);
		return ret;
	}

	/* results land directly in the pipeline buffers (no extra copy) */
	ret = test_ctx->rknn_api.get_outputs(out_data->out, out_data->size,
					     out_data->count, nullptr);
	if (ret < 0) {
		fprintf(stderr, "rknn_outputs_get failed! ret=%d\n", ret);
		return ret;
	}

	test_ctx->detect_count++;
	test_ctx->detect_time += get_time() - start_time;

	if (test_ctx->detect_count >= STATS_PERIOD) {
		fprintf(stderr, "[stats] npu round trip = %lu ms\n",
			test_ctx->detect_time / test_ctx->detect_count);
		test_ctx->detect_count = 0;
		test_ctx->detect_time = 0;
	}

	return 0;
}

int rknn_test::show_img(void *ctx, cv::Mat &img, float fps,
			struct rknn_out_data *out_data)
{
	int ret;
	rknn_test *test_ctx = static_cast<rknn_test *>(ctx);
	const unsigned long start_time = get_time();

	ret = test_ctx->post_process(test_ctx->user_data, img, fps, out_data);
	if (ret < 0)
		return ret;

	if (!test_ctx->headless)
		cv::imshow(test_ctx->win_name, img);

	if (!test_ctx->output_path.empty()) {
		if (!test_ctx->writer.isOpened()) {
			test_ctx->writer.open(test_ctx->output_path,
					      cv::VideoWriter::fourcc('m', 'p', '4', 'v'),
					      test_ctx->source_fps, img.size());
			if (!test_ctx->writer.isOpened()) {
				fprintf(stderr, "cannot write %s, output disabled\n",
					test_ctx->output_path.c_str());
				test_ctx->output_path.clear();
			}
		}
		if (test_ctx->writer.isOpened())
			test_ctx->writer.write(img);
	}

	test_ctx->show_count++;
	test_ctx->show_time += get_time() - start_time;

	if (test_ctx->show_count >= STATS_PERIOD) {
		fprintf(stderr, "[stats] post-process + display = %lu ms, %.2f fps\n",
			test_ctx->show_time / test_ctx->show_count, fps);
		test_ctx->show_count = 0;
		test_ctx->show_time = 0;
	}

	return 0;
}

/* ------------------------------------------------------------------------ */
/* Public API                                                               */
/* ------------------------------------------------------------------------ */

int rknn_test::load_model(const char *path)
{
	int ret;
	rknn_input_output_num in_out_num;

	is_model_load = false;
	output_size.clear();

	ret = rknn_api.load_model(path, RKNN_FLAG_PRIOR_MEDIUM);
	if (ret < 0)
		return ret;

	ret = rknn_api.get_in_out_num(&in_out_num);
	if (ret < 0)
		return ret;

	if (in_out_num.n_output == 0 || in_out_num.n_output > RKNN_MAX_OUTPUTS) {
		fprintf(stderr, "unsupported number of outputs: %u\n",
			in_out_num.n_output);
		return -1;
	}

	for (uint32_t i = 0; i < in_out_num.n_output; i++) {
		uint32_t size;

		ret = rknn_api.get_outsize(i, &size);
		if (ret < 0 || size == 0)
			return ret < 0 ? ret : -1;
		output_size.push_back(size);
	}

	is_model_load = true;
	return 0;
}

uint32_t rknn_test::output_elems(uint32_t index) const
{
	return index < output_size.size() ?
	       output_size[index] / static_cast<uint32_t>(sizeof(float)) : 0;
}

int rknn_test::set_input_info(int width, int height, int channels)
{
	if (!is_model_load) {
		fprintf(stderr, "should load model first!\n");
		return -1;
	}
	if (width <= 0 || height <= 0 || channels <= 0)
		return -1;

	const rknn_tensor_attr *attr = rknn_api.input_attr(input_index);
	const uint32_t n = static_cast<uint32_t>(width * height * channels);
	if (attr && attr->n_elems && attr->n_elems != n) {
		fprintf(stderr, "model input has %u elements, %dx%dx%d given\n",
			attr->n_elems, width, height, channels);
		return -1;
	}

	img_width = width;
	img_height = height;
	img_channels = channels;

	return 0;
}

int rknn_test::common_run(rknn_post_process_fn func, void *data)
{
	int ret;

	if (!is_model_load) {
		fprintf(stderr, "should load model first!\n");
		return -1;
	}
	if (!img_width || !img_height || !img_channels) {
		fprintf(stderr, "should set input info first!\n");
		return -1;
	}
	if (!func)
		return -1;

	post_process = func;
	user_data = data;

	if (!headless) {
		if (!getenv("DISPLAY") && !getenv("WAYLAND_DISPLAY")) {
			fprintf(stderr,
				"no graphical session (DISPLAY/WAYLAND_DISPLAY "
				"unset): use --headless\n");
			return -1;
		}
		cv::namedWindow(win_name, cv::WINDOW_AUTOSIZE);
	}

	rknn_opencv pipeline(4);

	ret = pipeline.start(get_img, detect_img, show_img, this, output_size,
			     live_source);
	if (ret < 0) {
		fprintf(stderr, "cannot start pipeline\n");
		return ret;
	}

	if (headless)
		printf(">>> running, Ctrl-C (SIGINT) or SIGTERM to stop <<<\n");
	else
		printf(">>> press ESC or q in the window to exit <<<\n");

	bool shown_any = false;
	int show_ret = 0;

	while (!stop_requested) {
		ret = pipeline.update_show();
		if (ret < 0) {
			if (ret < -1)
				show_ret = ret;
			break;
		}
		if (ret > 0)
			shown_any = true;

		if (!headless) {
			const int key = cv::waitKey(1) & 0xff;
			if (key == 27 || key == 'q' || key == 'Q')
				break;
			/* window closed with the title bar button */
			if (shown_any &&
			    cv::getWindowProperty(win_name,
						  cv::WND_PROP_VISIBLE) < 1)
				break;
		}
	}

	pipeline.stop();

	if (pipeline.dropped())
		printf("%llu stale frame(s) dropped to keep latency low\n",
		       static_cast<unsigned long long>(pipeline.dropped()));

	if (!headless)
		cv::destroyAllWindows();
	if (writer.isOpened())
		writer.release();

	if (show_ret < 0)
		return show_ret;
	return pipeline.error();
}

int rknn_test::run(const rknn_run_options &opt, rknn_post_process_fn func,
		   void *data)
{
	int ret;

	headless = opt.headless;
	output_path = opt.output;

	ret = open_source(opt);
	if (ret < 0)
		return ret;

	ret = common_run(func, data);

	cap.release();

	return ret;
}

int rknn_test::run(int video_node, rknn_post_process_fn func, void *data)
{
	rknn_run_options opt;

	opt.source = std::to_string(video_node);
	return run(opt, func, data);
}

int rknn_test::run(const char *video_name, rknn_post_process_fn func,
		   void *data)
{
	rknn_run_options opt;

	opt.source = video_name ? video_name : "";
	return run(opt, func, data);
}
