	int start(rknn_get_img_fn get_img, rknn_detect_img_fn detect_img,
		  rknn_show_img_fn show_img, void *user_ctx,
		  const std::vector<uint32_t> &out_sizes, bool drop);

	/*
	 * Display one processed frame if available.
	 * Returns 1 when a frame was shown, 0 on timeout, -1 when the pipeline
	 * is finished (see error()) or the show callback's negative code.
	 */
	int update_show(void);

	int stop(void);

	/* First error raised by a worker thread, 0 if none. */
	int error(void) const { return last_error.load(); }

	uint64_t dropped(void) const { return dropped_frames.load(); }
