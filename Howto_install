#ifndef RKNN_H
#define RKNN_H

#include <cstdint>
#include <vector>

#include "rockchip/rknn_api.h"

/*
 * Thin RAII wrapper around the RKNN v1 C API (librknn_api 1.7.x, host side).
 *
 * On a Raspberry Pi 5 / Orange Pi 6 Plus the library does not talk to a local
 * NPU: it forwards every call through npu_transfer_proxy to an RK1808 compute
 * stick plugged on USB (passive mode).
 *
 * Not thread-safe: a context must be driven by a single thread.
 */
class rknn {
private:
	bool initialized;
	bool has_run;
	rknn_context rknn_ctx;
	rknn_input_output_num in_out_num;
	std::vector<rknn_tensor_attr> in_attrs;
	std::vector<rknn_tensor_attr> out_attrs;
	std::vector<rknn_output> outputs;	/* reused for every frame */

	void release(void);

public:
	rknn();
	~rknn();

	rknn(const rknn &) = delete;
	rknn &operator=(const rknn &) = delete;

	int load_model(const char *model_path, uint32_t flag);

	int query(rknn_query_cmd cmd, void *info, uint32_t info_len);

	int set_input(uint32_t index, void *buf, uint32_t len);

	int run(rknn_run_extend *extend);

	int get_in_out_num(rknn_input_output_num *in_out) const;

	/* Size in bytes of output @index once converted to float. */
	int get_outsize(uint32_t index, uint32_t *size) const;

	const rknn_tensor_attr *input_attr(uint32_t index) const;

	const rknn_tensor_attr *output_attr(uint32_t index) const;

	/*
	 * Fetch all outputs of the last run() as float, directly into the caller
	 * buffers (no intermediate copy). @bufs and @sizes hold @count entries,
	 * @count must equal the number of model outputs.
	 */
	int get_outputs(float *const *bufs, const uint32_t *sizes,
			uint32_t count, rknn_output_extend *extend);
};

#endif
