/* ------------------------------------------------------------------------ */
/* Data files                                                               */
/* ------------------------------------------------------------------------ */

static bool readable(const std::string &path)
{
	return !path.empty() && access(path.c_str(), R_OK) == 0;
}

static std::string exe_dir(void)
{
	char buf[PATH_MAX];
	ssize_t n = readlink("/proc/self/exe", buf, sizeof(buf) - 1);

	if (n <= 0)
		return "";
	buf[n] = '\0';

	std::string p(buf);
	size_t pos = p.rfind('/');
	return pos == std::string::npos ? "" : p.substr(0, pos);
}

/*
 * Resolution order: explicit option, $SSD_DATA_DIR, build tree next to the
 * binary, installed tree, compiled-in default, then the original relative
 * paths for backward compatibility.
 */
static std::string find_data_file(const char *name, const std::string &override_path)
{
	if (!override_path.empty())
		return readable(override_path) ? override_path : "";

	std::vector<std::string> dirs;
	const char *env = getenv("SSD_DATA_DIR");
	const std::string exe = exe_dir();

	if (env && *env)
		dirs.push_back(env);
	if (!exe.empty()) {
		dirs.push_back(exe + "/../models/ssd");
		dirs.push_back(exe + "/models/ssd");
		dirs.push_back(exe + "/../share/slave-mobilenet-ssd/models/ssd");
	}
	dirs.push_back(SSD_DEFAULT_DATA_DIR);
	dirs.push_back("models/ssd");
	dirs.push_back("../models/ssd");

	for (const auto &d : dirs) {
		std::string p = d + "/" + name;
		if (readable(p))
			return p;
	}
	return "";
}

static int loadLabelName(const std::string &locationFilename,
			 std::string *labels, int max_labels)
{
	std::ifstream fin(locationFilename);
	std::string line;
	int lineNum = 0;

	if (!fin) {
		fprintf(stderr, "cannot open %s\n", locationFilename.c_str());
		return -1;
	}

	while (lineNum < max_labels && std::getline(fin, line)) {
		if (!line.empty() && line.back() == '\r')
			line.pop_back();
		labels[lineNum++] = line;
	}

	for (int i = lineNum; i < max_labels; i++)
		labels[i] = "class " + std::to_string(i);

	if (lineNum < max_labels)
		fprintf(stderr, "warning: %s has %d labels, %d expected\n",
			locationFilename.c_str(), lineNum, max_labels);

	return lineNum;
}

static int loadCoderOptions(const std::string &locationFilename,
			    float (*boxPriors)[NUM_RESULTS])
{
	std::ifstream fin(locationFilename);
	std::string line;
	int lineNum = 0;

	if (!fin) {
		fprintf(stderr, "cannot open %s\n", locationFilename.c_str());
		return -1;
	}

	while (std::getline(fin, line)) {
		std::replace(line.begin(), line.end(), ',', ' ');
		std::istringstream iss(line);
		float number;
		int priorIndex = 0;

		if (line.find_first_not_of(" \t\r") == std::string::npos)
			continue;	/* blank line (e.g. trailing newline) */

		if (lineNum >= 4) {
			fprintf(stderr, "%s: more than 4 rows\n",
				locationFilename.c_str());
			return -1;
		}

		while (iss >> number) {
			if (priorIndex >= NUM_RESULTS) {
				priorIndex++;
				break;
			}
			boxPriors[lineNum][priorIndex++] = number;
		}

		if (priorIndex != NUM_RESULTS) {
			fprintf(stderr, "%s: row %d has %d values, %d expected\n",
				locationFilename.c_str(), lineNum, priorIndex,
				NUM_RESULTS);
			return -1;
		}

		lineNum++;
	}

	if (lineNum != 4) {
		fprintf(stderr, "%s: %d rows, 4 expected\n",
			locationFilename.c_str(), lineNum);
		return -1;
	}

	return 0;
}

/* ------------------------------------------------------------------------ */
/* SSD post-processing                                                      */
/* ------------------------------------------------------------------------ */

static inline float expit(float x)
{
	return 1.0f / (1.0f + std::exp(-x));
}

static inline float CalculateOverlap(const detection &a, const detection &b)
{
	const float w = std::max(0.f, std::min(a.xmax, b.xmax) - std::max(a.xmin, b.xmin));
	const float h = std::max(0.f, std::min(a.ymax, b.ymax) - std::max(a.ymin, b.ymin));
	const float i = w * h;
	const float u = (a.xmax - a.xmin) * (a.ymax - a.ymin) +
			(b.xmax - b.xmin) * (b.ymax - b.ymin) - i;
	return u <= 0.f ? 0.f : (i / u);
}

/* Decode one anchor only (the original decoded all 1917 every frame). */
static inline void decodeCenterSizeBox(const float *predictions,
				       const float (*boxPriors)[NUM_RESULTS],
				       detection &d)
{
	const int i = d.anchor;
	const float ycenter = predictions[i * 4 + 0] / Y_SCALE * boxPriors[2][i] + boxPriors[0][i];
	const float xcenter = predictions[i * 4 + 1] / X_SCALE * boxPriors[3][i] + boxPriors[1][i];
	const float h = std::exp(predictions[i * 4 + 2] / H_SCALE) * boxPriors[2][i];
	const float w = std::exp(predictions[i * 4 + 3] / W_SCALE) * boxPriors[3][i];

	d.ymin = ycenter - h / 2.0f;
	d.xmin = xcenter - w / 2.0f;
	d.ymax = ycenter + h / 2.0f;
	d.xmax = xcenter + w / 2.0f;
}

/*
 * Keep, for each anchor, its best class (background excluded) when the
 * score reaches min_score. expit() is monotonic, so the comparison is done on
 * the raw logit and the sigmoid computed once per candidate.
 */
static void selectCandidates(const float *outputClasses, struct ssd_data *ssd)
{
	ssd->cand.clear();

	for (int i = 0; i < NUM_RESULTS; ++i) {
		const float *row = outputClasses + i * NUM_CLASSES;
		const float *best = std::max_element(row + 1, row + NUM_CLASSES);

		if (*best >= ssd->min_logit) {
			detection d;
			d.anchor = i;
			d.cls = static_cast<int>(best - row);
			d.score = expit(*best);
			d.ymin = d.xmin = d.ymax = d.xmax = 0.f;
			ssd->cand.push_back(d);
		}
	}

	auto by_score = [](const detection &a, const detection &b) {
		return a.score > b.score;
	};

	if (ssd->cand.size() > TOP_K) {
		std::nth_element(ssd->cand.begin(), ssd->cand.begin() + TOP_K,
				 ssd->cand.end(), by_score);
		ssd->cand.resize(TOP_K);
	}
	std::sort(ssd->cand.begin(), ssd->cand.end(), by_score);
}

/* Greedy class-aware NMS on score-sorted candidates. */
static void nms(struct ssd_data *ssd)
{
	ssd->kept.clear();

	for (const auto &c : ssd->cand) {
		bool suppressed = false;

		for (const auto &k : ssd->kept) {
			if (k.cls == c.cls &&
			    CalculateOverlap(c, k) >= ssd->nms_threshold) {
				suppressed = true;
				break;
			}
		}
		if (!suppressed) {
			ssd->kept.push_back(c);
			if (ssd->kept.size() >= ssd->max_det)
				break;
		}
	}
}

static int post_process(void *data, cv::Mat &img, float fps,
			const struct rknn_out_data *out_data)
{
	char tmp_buf[64];
	struct ssd_data *ssd = static_cast<struct ssd_data *>(data);
	const float *predictions = nullptr;
	const float *outputClasses = nullptr;

	ssd->frame++;

	/* identify outputs by size instead of trusting their order */
	for (uint32_t i = 0; i < out_data->count; i++) {
		const uint32_t n = out_data->size[i] / sizeof(float);
		if (n == NUM_RESULTS * 4)
			predictions = out_data->out[i];
		else if (n == NUM_RESULTS * NUM_CLASSES)
			outputClasses = out_data->out[i];
	}

	if (!predictions || !outputClasses) {
		fprintf(stderr, "model outputs do not match MobileNet-SSD "
			"(%d anchors x %d classes)\n", NUM_RESULTS, NUM_CLASSES);
		return -1;
	}

	selectCandidates(outputClasses, ssd);
	for (auto &c : ssd->cand)
		decodeCenterSizeBox(predictions, ssd->boxPriors, c);
	nms(ssd);

	const int cols = img.cols;
	const int rows = img.rows;
	const float fcols = static_cast<float>(cols);
	const float frows = static_cast<float>(rows);

	for (const auto &d : ssd->kept) {
		const int x1 = std::clamp(static_cast<int>(d.xmin * fcols), 0, cols - 1);
		const int y1 = std::clamp(static_cast<int>(d.ymin * frows), 0, rows - 1);
		const int x2 = std::clamp(static_cast<int>(d.xmax * fcols), 0, cols - 1);
		const int y2 = std::clamp(static_cast<int>(d.ymax * frows), 0, rows - 1);
		const std::string &label = ssd->labels[d.cls];
		const cv::Scalar &color = colorArray[d.cls % 10];

		if (ssd->print)
			printf("frame %llu: %s %.2f [%d,%d,%d,%d]\n", ssd->frame,
			       label.c_str(), d.score, x1, y1, x2, y2);

		snprintf(tmp_buf, sizeof(tmp_buf), "%s %d%%", label.c_str(),
			 static_cast<int>(d.score * 100.0f + 0.5f));

		int baseline = 0;
		const cv::Size ts = cv::getTextSize(tmp_buf, cv::FONT_HERSHEY_SIMPLEX,
						    0.5, 1, &baseline);
		const int ty = std::max(y1, ts.height + 4);

		cv::rectangle(img, cv::Point(x1, y1), cv::Point(x2, y2), color, 2);
		cv::rectangle(img, cv::Point(x1, ty - ts.height - 4),
			      cv::Point(x1 + ts.width + 4, ty), color, cv::FILLED);
		cv::putText(img, tmp_buf, cv::Point(x1 + 2, ty - 3),
			    cv::FONT_HERSHEY_SIMPLEX, 0.5,
			    cv::Scalar(255, 255, 255, 255), 1, cv::LINE_AA);
	}

	snprintf(tmp_buf, sizeof(tmp_buf), "FPS:%5.2f", fps);
	/* dark outline keeps the counter readable on any background */
	cv::putText(img, tmp_buf, cv::Point(20, 40), cv::FONT_HERSHEY_PLAIN, 2,
		    cv::Scalar(0, 0, 0, 255), 5);
	cv::putText(img, tmp_buf, cv::Point(20, 40), cv::FONT_HERSHEY_PLAIN, 2,
		    cv::Scalar(0, 0, 255, 255), 2);

	if (ssd->print)
		fflush(stdout);

	return 0;
}

/* ------------------------------------------------------------------------ */
/* main                                                                     */
/* ------------------------------------------------------------------------ */

static void on_signal(int sig)
{
	(void)sig;
	rknn_test::request_stop();
}

static void usage(const char *prog)
{
	printf("Usage: %s [options]\n"
	       "MobileNet-SSD detection offloaded to an RK1808 USB compute stick.\n\n"
	       "  -s, --source SRC     video source: V4L2 index, /dev/videoN, file, URL\n"
	       "                       or GStreamer pipeline (default: first USB camera)\n"
	       "  -W, --width N        capture width  (V4L2, default 640)\n"
	       "  -H, --height N       capture height (V4L2, default 480)\n"
	       "      --no-mjpg        do not request MJPG from the camera\n"
	       "  -m, --model FILE     .rknn model     (default: %s)\n"
	       "  -l, --labels FILE    labels file     (default: %s)\n"
	       "  -p, --priors FILE    box priors file (default: %s)\n"
	       "  -t, --threshold F    min score, 0..1 (default 0.40)\n"
	       "  -n, --nms F          NMS IoU threshold, 0..1 (default 0.45)\n"
	       "  -k, --max-det N      max detections per frame (default 50)\n"
	       "      --headless       no window, print detections on stdout\n"
	       "  -o, --output FILE    write the annotated video (mp4)\n"
	       "  -q, --quiet          do not print detections\n"
	       "  -V, --version        print version\n"
	       "  -h, --help           this help\n\n"
	       "Data files are searched in $SSD_DATA_DIR, next to the binary, then in\n"
	       "%s.\n",
	       prog, MODEL_FILE, LABEL_FILE, BOX_PRIO_FILE, SSD_DEFAULT_DATA_DIR);
}

static bool parse_float(const char *s, float lo, float hi, float *out)
{
	char *end = nullptr;
	errno = 0;
	float v = strtof(s, &end);
	if (errno || end == s || *end || v < lo || v > hi)
		return false;
	*out = v;
	return true;
}

static bool parse_int(const char *s, long lo, long hi, int *out)
{
	char *end = nullptr;
	errno = 0;
	long v = strtol(s, &end, 10);
	if (errno || end == s || *end || v < lo || v > hi)
		return false;
	*out = static_cast<int>(v);
	return true;
}

int main(int argc, char **argv)
{
	int ret;
	std::string model_opt, label_opt, prior_opt;
	rknn_run_options run_opt;
	float min_score = 0.4f;
	float nms_threshold = 0.45f;
	int max_det = 50;
	bool quiet = false;

	enum { OPT_NO_MJPG = 1000, OPT_HEADLESS };
	static const struct option long_opts[] = {
		{ "source",    required_argument, nullptr, 's' },
		{ "width",     required_argument, nullptr, 'W' },
		{ "height",    required_argument, nullptr, 'H' },
		{ "no-mjpg",   no_argument,       nullptr, OPT_NO_MJPG },
		{ "model",     required_argument, nullptr, 'm' },
		{ "labels",    required_argument, nullptr, 'l' },
		{ "priors",    required_argument, nullptr, 'p' },
		{ "threshold", required_argument, nullptr, 't' },
		{ "nms",       required_argument, nullptr, 'n' },
		{ "max-det",   required_argument, nullptr, 'k' },
		{ "headless",  no_argument,       nullptr, OPT_HEADLESS },
		{ "output",    required_argument, nullptr, 'o' },
		{ "quiet",     no_argument,       nullptr, 'q' },
		{ "version",   no_argument,       nullptr, 'V' },
		{ "help",      no_argument,       nullptr, 'h' },
		{ nullptr, 0, nullptr, 0 },
	};

	/* line buffered even when piped (journald, tee, ...) */
	setvbuf(stdout, nullptr, _IOLBF, 0);

	int c;
	while ((c = getopt_long(argc, argv, "s:W:H:m:l:p:t:n:k:o:qVh",
				long_opts, nullptr)) != -1) {
		switch (c) {
		case 's': run_opt.source = optarg; break;
		case 'W':
			if (!parse_int(optarg, 16, 7680, &run_opt.cap_width)) {
				fprintf(stderr, "invalid width: %s\n", optarg);
				return EXIT_FAILURE;
			}
			break;
		case 'H':
			if (!parse_int(optarg, 16, 4320, &run_opt.cap_height)) {
				fprintf(stderr, "invalid height: %s\n", optarg);
				return EXIT_FAILURE;
			}
			break;
		case OPT_NO_MJPG: run_opt.mjpg = false; break;
		case 'm': model_opt = optarg; break;
		case 'l': label_opt = optarg; break;
		case 'p': prior_opt = optarg; break;
		case 't':
			if (!parse_float(optarg, 0.01f, 0.99f, &min_score)) {
				fprintf(stderr, "invalid threshold: %s\n", optarg);
				return EXIT_FAILURE;
			}
			break;
		case 'n':
			if (!parse_float(optarg, 0.0f, 1.0f, &nms_threshold)) {
				fprintf(stderr, "invalid nms: %s\n", optarg);
				return EXIT_FAILURE;
			}
			break;
		case 'k':
			if (!parse_int(optarg, 1, 1000, &max_det)) {
				fprintf(stderr, "invalid max-det: %s\n", optarg);
				return EXIT_FAILURE;
			}
			break;
		case OPT_HEADLESS: run_opt.headless = true; break;
		case 'o': run_opt.output = optarg; break;
		case 'q': quiet = true; break;
		case 'V': printf("ssd_demo %s\n", SSD_VERSION); return EXIT_SUCCESS;
		case 'h': usage(argv[0]); return EXIT_SUCCESS;
		default:  usage(argv[0]); return EXIT_FAILURE;
		}
	}
	if (optind < argc) {
		fprintf(stderr, "unexpected argument: %s\n", argv[optind]);
		return EXIT_FAILURE;
	}

	struct sigaction sa;
	memset(&sa, 0, sizeof(sa));
	sa.sa_handler = on_signal;
	sigemptyset(&sa.sa_mask);
	sigaction(SIGINT, &sa, nullptr);
	sigaction(SIGTERM, &sa, nullptr);
	signal(SIGPIPE, SIG_IGN);

	/* load label and boxPriors */
	const std::string label_path = find_data_file(LABEL_FILE, label_opt);
	if (label_path.empty()) {
		fprintf(stderr, "need label file (%s).\n", LABEL_FILE);
		return EXIT_FAILURE;
	}

	const std::string box_path = find_data_file(BOX_PRIO_FILE, prior_opt);
	if (box_path.empty()) {
		fprintf(stderr, "need box priors file (%s).\n", BOX_PRIO_FILE);
		return EXIT_FAILURE;
	}

	const std::string model_path = find_data_file(MODEL_FILE, model_opt);
	if (model_path.empty()) {
		fprintf(stderr, "need model file (%s).\n", MODEL_FILE);
		return EXIT_FAILURE;
	}

	/* ~31 KB of priors + scratch: keep it off the stack */
	std::unique_ptr<ssd_data> data(new ssd_data());
	data->min_score = min_score;
	data->min_logit = std::log(min_score / (1.0f - min_score));
	data->nms_threshold = nms_threshold;
	data->max_det = static_cast<size_t>(max_det);
	data->print = run_opt.headless && !quiet;
	data->frame = 0;
	data->cand.reserve(NUM_RESULTS);
	data->kept.reserve(static_cast<size_t>(max_det));

	if (loadLabelName(label_path, data->labels, NUM_CLASSES) < 0)
		return EXIT_FAILURE;
	if (loadCoderOptions(box_path, data->boxPriors) < 0)
		return EXIT_FAILURE;

	rknn_test test(WIN_NAME);

	ret = test.load_model(model_path.c_str());
	if (ret < 0) {
		fprintf(stderr, "load_model error!!!\n");
		return EXIT_FAILURE;
	}

	ret = test.set_input_info(INPUT_WIDTH, INPUT_HEIGHT, INPUT_CHANNEL);
	if (ret < 0) {
		fprintf(stderr, "set_input_info error!!!\n");
		return EXIT_FAILURE;
	}

	ret = test.run(run_opt, post_process, data.get());

	return ret < 0 ? EXIT_FAILURE : EXIT_SUCCESS;
}
