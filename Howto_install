#include <vector>

#include <getopt.h>
#include <unistd.h>

#include <opencv2/imgproc.hpp>

#include "rknn_test.h"

#ifndef SSD_VERSION
#define SSD_VERSION "dev"
#endif
#ifndef SSD_DEFAULT_DATA_DIR
#define SSD_DEFAULT_DATA_DIR "/usr/share/slave-mobilenet-ssd/models/ssd"
#endif

#define NUM_RESULTS	1917
#define NUM_CLASSES	91

static const char *WIN_NAME = "ssd";

static const char *MODEL_FILE = "mobilenet_ssd.rknn";
static const char *LABEL_FILE = "coco_labels_list.txt";
static const char *BOX_PRIO_FILE = "box_priors.txt";

static const int INPUT_WIDTH = 300;
static const int INPUT_HEIGHT = 300;
static const int INPUT_CHANNEL = 3;

/* candidates kept (best scores first) before NMS */
static const size_t TOP_K = 200;

#define Y_SCALE  10.0f
#define X_SCALE  10.0f
#define H_SCALE  5.0f
#define W_SCALE  5.0f

struct detection {
	int anchor;
	int cls;
	float score;
	float ymin, xmin, ymax, xmax;
};

struct ssd_data {
	float boxPriors[4][NUM_RESULTS];
	std::string labels[NUM_CLASSES];

	float min_score;
	float min_logit;	/* logit(min_score), avoids 170k expf() per frame */
	float nms_threshold;
	size_t max_det;
	bool print;		/* print detections on stdout */
	unsigned long long frame;

	std::vector<detection> cand;	/* scratch, reused every frame */
	std::vector<detection> kept;
};

static const cv::Scalar colorArray[10] = {
