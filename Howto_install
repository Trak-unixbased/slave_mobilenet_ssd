### `packaging/systemd/npu-transfer-proxy.service` (nouveau, remplace `npud`)
```ini
[Unit]
Description=Rockchip NPU transfer proxy (RK1808 USB compute stick, passive mode)
Documentation=https://github.com/Trak-unixbased/slave_mobilenet_ssd
# Also pulled in by udev (60-rk1808-npu.rules) when a stick is plugged.

[Service]
Type=simple
ExecStart=/usr/lib/slave-mobilenet-ssd/npu_transfer_proxy
Restart=on-failure
RestartSec=2s

# Clients (librknn_api) connect through the abstract unix socket
# "@transfer_proxy" of the host network namespace: no PrivateNetwork.

# Unprivileged: USB access comes from the udev rule (group plugdev).
DynamicUser=yes
SupplementaryGroups=plugdev
StateDirectory=npu-transfer-proxy
WorkingDirectory=/var/lib/npu-transfer-proxy

# Only USB character devices are reachable.
DevicePolicy=closed
DeviceAllow=char-usb_device rw

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
