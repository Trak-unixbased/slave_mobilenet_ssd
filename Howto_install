#include "rknn.h"

#include <cerrno>
#include <cstdio>
#include <cstring>
#include <fstream>
#include <limits>

static const char *rknn_err_str(int err)
{
	switch (err) {
	case RKNN_ERR_FAIL:			return "execution failed";
	case RKNN_ERR_TIMEOUT:			return "timeout";
	case RKNN_ERR_DEVICE_UNAVAILABLE:	return "device unavailable";
	case RKNN_ERR_MALLOC_FAIL:		return "memory allocation failed";
	case RKNN_ERR_PARAM_INVALID:		return "invalid parameter";
	case RKNN_ERR_MODEL_INVALID:		return "invalid model";
	case RKNN_ERR_CTX_INVALID:		return "invalid context";
	case RKNN_ERR_INPUT_INVALID:		return "invalid input";
	case RKNN_ERR_OUTPUT_INVALID:		return "invalid output";
	case RKNN_ERR_DEVICE_UNMATCH:		return "device/SDK mismatch, update the stick firmware";
	case RKNN_ERR_INCOMPATILE_PRE_COMPILE_MODEL:
		return "pre-compiled model incompatible with the NPU driver";
	default:				return "unknown error";
	}
}

rknn::rknn()
	: initialized(false), has_run(false), rknn_ctx(0)
{
	memset(&in_out_num, 0, sizeof(in_out_num));
}

rknn::~rknn()
{
	release();
}

void rknn::release(void)
{
	if (initialized)
		rknn_destroy(rknn_ctx);

	initialized = false;
	has_run = false;
	rknn_ctx = 0;
	memset(&in_out_num, 0, sizeof(in_out_num));
	in_attrs.clear();
	out_attrs.clear();
	outputs.clear();
}

int rknn::load_model(const char *model_path, uint32_t flag)
{
	int ret;

	if (!model_path)
		return RKNN_ERR_PARAM_INVALID;

	/* allow reloading a model on the same object */
	release();

	std::ifstream fin(model_path, std::ios::binary | std::ios::ate);
	if (!fin) {
		fprintf(stderr, "cannot open model %s: %s\n", model_path,
			strerror(errno));
		return RKNN_ERR_MODEL_INVALID;
	}

	const std::streamoff len = fin.tellg();
	if (len <= 0 ||
	    static_cast<unsigned long long>(len) >
	    std::numeric_limits<uint32_t>::max()) {
		fprintf(stderr, "invalid model size for %s\n", model_path);
		return RKNN_ERR_MODEL_INVALID;
	}

	std::vector<unsigned char> model(static_cast<size_t>(len));
	fin.seekg(0, std::ios::beg);
	if (!fin.read(reinterpret_cast<char *>(model.data()), len)) {
		fprintf(stderr, "short read on %s\n", model_path);
		return RKNN_ERR_MODEL_INVALID;
	}

	printf("loading model %s (%lld bytes)...\n", model_path,
	       static_cast<long long>(len));

	ret = rknn_init(&rknn_ctx, model.data(), static_cast<uint32_t>(len),
			flag);
	if (ret < 0) {
		fprintf(stderr, "rknn_init failed: %d (%s)\n", ret,
			rknn_err_str(ret));
		if (ret == RKNN_ERR_DEVICE_UNAVAILABLE || ret == RKNN_ERR_FAIL)
			fprintf(stderr,
				"hint: is the RK1808 stick plugged in and is "
				"'systemctl status npu-transfer-proxy' active?\n");
		rknn_ctx = 0;
		return ret;
	}
	initialized = true;

	rknn_sdk_version ver;
	memset(&ver, 0, sizeof(ver));
	if (rknn_query(rknn_ctx, RKNN_QUERY_SDK_VERSION, &ver,
		       sizeof(ver)) == 0)
		printf("rknn api: %.*s, driver: %.*s\n",
		       static_cast<int>(sizeof(ver.api_version)), ver.api_version,
		       static_cast<int>(sizeof(ver.drv_version)), ver.drv_version);

	ret = rknn_query(rknn_ctx, RKNN_QUERY_IN_OUT_NUM, &in_out_num,
			 sizeof(in_out_num));
	if (ret < 0) {
		fprintf(stderr, "query in/out num failed: %d\n", ret);
		goto fail;
	}

	printf("input num = %u, output num = %u\n",
	       in_out_num.n_input, in_out_num.n_output);

	for (uint32_t i = 0; i < in_out_num.n_input; i++) {
		rknn_tensor_attr attr;
		memset(&attr, 0, sizeof(attr));
		attr.index = i;
		ret = rknn_query(rknn_ctx, RKNN_QUERY_INPUT_ATTR, &attr,
				 sizeof(attr));
		if (ret < 0)
			goto fail;
		printf("input  %u: %.*s, n_elems = %u, fmt = %d, type = %d\n",
		       i, RKNN_MAX_NAME_LEN, attr.name, attr.n_elems,
		       attr.fmt, attr.type);
		in_attrs.push_back(attr);
	}

	for (uint32_t i = 0; i < in_out_num.n_output; i++) {
		rknn_tensor_attr attr;
		memset(&attr, 0, sizeof(attr));
		attr.index = i;
		ret = rknn_query(rknn_ctx, RKNN_QUERY_OUTPUT_ATTR, &attr,
				 sizeof(attr));
		if (ret < 0)
			goto fail;
		printf("output %u: %.*s, n_elems = %u, type = %02x, qnt_type = %02x\n",
		       i, RKNN_MAX_NAME_LEN, attr.name, attr.n_elems,
		       attr.type, attr.qnt_type);
		out_attrs.push_back(attr);
	}

	outputs.resize(in_out_num.n_output);
	return 0;

fail:
	release();
	return ret < 0 ? ret : RKNN_ERR_MODEL_INVALID;
}

int rknn::query(rknn_query_cmd cmd, void *info, uint32_t info_len)
{
	if (!info)
		return RKNN_ERR_PARAM_INVALID;
	if (!initialized)
		return RKNN_ERR_CTX_INVALID;

	return rknn_query(rknn_ctx, cmd, info, info_len);
}

int rknn::set_input(uint32_t index, void *buf, uint32_t len)
{
	rknn_input input;

	if (!buf || !len)
		return RKNN_ERR_PARAM_INVALID;
	if (!initialized)
		return RKNN_ERR_CTX_INVALID;
	if (index >= in_out_num.n_input)
		return RKNN_ERR_INPUT_INVALID;

	memset(&input, 0, sizeof(input));
	input.index = index;
	input.buf = buf;
	input.size = len;
	input.pass_through = 0;
	input.type = RKNN_TENSOR_UINT8;
	input.fmt = RKNN_TENSOR_NHWC;

	return rknn_inputs_set(rknn_ctx, 1, &input);
}

int rknn::run(rknn_run_extend *extend)
{
	int ret;

	if (!initialized)
		return RKNN_ERR_CTX_INVALID;

	ret = rknn_run(rknn_ctx, extend);
	has_run = (ret == 0);

	return ret;
}

int rknn::get_in_out_num(rknn_input_output_num *in_out) const
{
	if (!in_out)
		return RKNN_ERR_PARAM_INVALID;
	if (!initialized)
		return RKNN_ERR_CTX_INVALID;

	*in_out = in_out_num;
	return 0;
}

int rknn::get_outsize(uint32_t index, uint32_t *size) const
{
	if (!size)
		return RKNN_ERR_PARAM_INVALID;

	*size = 0;

	if (!initialized)
		return RKNN_ERR_CTX_INVALID;
	if (index >= out_attrs.size())
		return RKNN_ERR_OUTPUT_INVALID;

	*size = out_attrs[index].n_elems * sizeof(float);
	return 0;
}

const rknn_tensor_attr *rknn::input_attr(uint32_t index) const
{
	return index < in_attrs.size() ? &in_attrs[index] : nullptr;
}

const rknn_tensor_attr *rknn::output_attr(uint32_t index) const
{
	return index < out_attrs.size() ? &out_attrs[index] : nullptr;
}

int rknn::get_outputs(float *const *bufs, const uint32_t *sizes,
		      uint32_t count, rknn_output_extend *extend)
{
	int ret;
	rknn_output_extend local_ext;

	if (!bufs || !sizes)
		return RKNN_ERR_PARAM_INVALID;
	if (!initialized)
		return RKNN_ERR_CTX_INVALID;
	if (count != in_out_num.n_output || !has_run)
		return RKNN_ERR_OUTPUT_INVALID;

	for (uint32_t i = 0; i < count; i++) {
		const uint32_t need = out_attrs[i].n_elems * sizeof(float);

		if (!bufs[i] || sizes[i] < need)
			return RKNN_ERR_PARAM_INVALID;

		memset(&outputs[i], 0, sizeof(outputs[i]));
		outputs[i].want_float = 1;
		outputs[i].is_prealloc = 1;
		outputs[i].index = i;
		outputs[i].buf = bufs[i];
		outputs[i].size = need;
	}

	memset(&local_ext, 0, sizeof(local_ext));
	ret = rknn_outputs_get(rknn_ctx, count, outputs.data(),
			       extend ? extend : &local_ext);
	if (ret < 0)
		return ret;

	/* one rknn_run() -> one rknn_outputs_get() */
	has_run = false;

	return rknn_outputs_release(rknn_ctx, count, outputs.data());
}
