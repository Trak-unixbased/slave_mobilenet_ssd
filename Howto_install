#!/usr/bin/env bash
#
# Fetch the RKNN *host* SDK needed to drive an RK1808 USB compute stick
# (passive mode) from an aarch64 Linux host (Raspberry Pi 5, Orange Pi 6
# Plus, ...):
#
#   include/rockchip/rknn_api.h   RKNN v1 C API header
#   lib/librknn_api.so            host client library 1.7.5 (LION_PUMA)
#   bin/npu_transfer_proxy        USB transport daemon for the stick
#
# The historical source (repo.rock-chips.com) is offline. Files now come from
# Rockchip's GitHub repositories, pinned to a commit and checked by SHA-256.
#
# Note: rknpu's own lib64/librknn_api.so is the *on-device* runtime loader
# (it dlopen()s librknn_runtime.so) and cannot drive a stick: the host client
# ships only inside the rknn-toolkit-lite wheel.
#
# Usage:
#   install_rknn_api.sh [--prefix DIR]   stage the SDK (default: ./third_party/rknn)
#   sudo install_rknn_api.sh --system    install into /usr/local + udev + systemd
#                                        (manual install; prefer the .deb)
#   --wheel FILE / --header FILE         use local copies (offline build)
#   --force                              allow a non-aarch64 host (staging only)

set -euo pipefail

readonly RKNPU_COMMIT="e0cb42b645707ca12518c43dcee7c4968cbe918f"
readonly TOOLKIT_COMMIT="8e30ee72e772d6d39f2fcaf4047fead450b3ee89"

readonly HEADER_URL="https://raw.githubusercontent.com/rockchip-linux/rknpu/${RKNPU_COMMIT}/rknn/rknn_api/librknn_api/include/rknn_api.h"
readonly WHEEL_NAME="rknn_toolkit_lite-1.7.5-cp310-cp310-linux_aarch64.whl"
readonly WHEEL_URL="https://raw.githubusercontent.com/rockchip-linux/rknn-toolkit/${TOOLKIT_COMMIT}/rknn-toolkit-lite/packages/${WHEEL_NAME}"

readonly HEADER_SHA256="704ff9bd6cc05f3767d4eaa16341632df3bb7789dd05abe317c90d2c00eebc72"
readonly WHEEL_SHA256="d1c3f119f7cae1ce9eed07c6d753c6554afec47b128afb2d0582a3d462a9b14c"
readonly LIB_SHA256="2b22f0e425958f66b36bf65b4602eddca081d27e3e8a195b08dfbd1af4d4038e"
readonly PROXY_SHA256="c4e77bdfe9256cf0671094db8d98fbcdba65a71cafa04040742c1bfff4052900"

readonly LIB_MEMBER="rknnlite/api/lib/hardware/LION_PUMA/linux-aarch64/librknn_api.so"
readonly PROXY_MEMBER="rknnlite/3rdparty/platform-tools/ntp/linux-aarch64/npu_transfer_proxy"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

PREFIX="${REPO_DIR}/third_party/rknn"
SYSTEM=0
FORCE=0
LOCAL_WHEEL=""
LOCAL_HEADER=""

die() { echo "error: $*" >&2; exit 1; }
log() { echo "==> $*"; }

usage() {
	sed -n '3,/^$/s/^# \{0,1\}//p' "${BASH_SOURCE[0]}"
	exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
	case "$1" in
	--prefix)  [[ $# -ge 2 ]] || die "--prefix needs a value"; PREFIX="$2"; shift 2 ;;
	--system)  SYSTEM=1; PREFIX="/usr/local"; shift ;;
	--wheel)   [[ $# -ge 2 ]] || die "--wheel needs a value"; LOCAL_WHEEL="$2"; shift 2 ;;
	--header)  [[ $# -ge 2 ]] || die "--header needs a value"; LOCAL_HEADER="$2"; shift 2 ;;
	--force)   FORCE=1; shift ;;
	-h|--help) usage 0 ;;
	*)         echo "unknown option: $1" >&2; usage 1 ;;
	esac
done

ARCH="$(uname -m)"
if [[ "${ARCH}" != "aarch64" && "${FORCE}" -eq 0 ]]; then
	die "host is ${ARCH}: the Rockchip binaries are aarch64 only (use --force to stage anyway)"
fi

if [[ "${SYSTEM}" -eq 1 && "${EUID}" -ne 0 ]]; then
	die "--system requires root (sudo)"
fi

for tool in curl sha256sum python3 install; do
	command -v "${tool}" >/dev/null 2>&1 || die "missing tool: ${tool} (apt install curl coreutils python3)"
done

check_sha256() {
	local file="$1" expected="$2" actual
	actual="$(sha256sum "${file}" | cut -d' ' -f1)"
	[[ "${actual}" == "${expected}" ]] ||
		die "checksum mismatch for ${file}: got ${actual}, expected ${expected}"
}

fetch() {
	local url="$1" out="$2"
	curl --fail --silent --show-error --location --retry 3 \
	     --proto '=https' --tlsv1.2 -o "${out}" "${url}"
}

WORK="$(mktemp -d)"
trap 'rm -rf -- "${WORK}"' EXIT

# --- header ------------------------------------------------------------------
if [[ -n "${LOCAL_HEADER}" ]]; then
	cp -- "${LOCAL_HEADER}" "${WORK}/rknn_api.h"
else
	log "downloading rknn_api.h (rknpu@${RKNPU_COMMIT:0:7})"
	fetch "${HEADER_URL}" "${WORK}/rknn_api.h"
fi
check_sha256 "${WORK}/rknn_api.h" "${HEADER_SHA256}"

# --- wheel -> librknn_api.so + npu_transfer_proxy ----------------------------
if [[ -n "${LOCAL_WHEEL}" ]]; then
	cp -- "${LOCAL_WHEEL}" "${WORK}/${WHEEL_NAME}"
else
	log "downloading ${WHEEL_NAME} (rknn-toolkit@${TOOLKIT_COMMIT:0:7})"
	fetch "${WHEEL_URL}" "${WORK}/${WHEEL_NAME}"
fi
check_sha256 "${WORK}/${WHEEL_NAME}" "${WHEEL_SHA256}"

log "extracting host library and proxy"
python3 -I - "${WORK}/${WHEEL_NAME}" "${WORK}" "${LIB_MEMBER}" "${PROXY_MEMBER}" <<'PY'
import os, sys, zipfile
whl, out, *members = sys.argv[1:]
with zipfile.ZipFile(whl) as z:
    for m in members:
        dest = os.path.join(out, os.path.basename(m))
        with z.open(m) as src, open(dest, "wb") as dst:
            dst.write(src.read())
PY
check_sha256 "${WORK}/librknn_api.so" "${LIB_SHA256}"
check_sha256 "${WORK}/npu_transfer_proxy" "${PROXY_SHA256}"

# --- install -----------------------------------------------------------------
log "installing into ${PREFIX}"
install -d -m 0755 "${PREFIX}/include/rockchip" "${PREFIX}/lib" "${PREFIX}/bin"
install -m 0644 "${WORK}/rknn_api.h" "${PREFIX}/include/rockchip/rknn_api.h"
install -m 0644 "${WORK}/librknn_api.so" "${PREFIX}/lib/librknn_api.so"
install -m 0755 "${WORK}/npu_transfer_proxy" "${PREFIX}/bin/npu_transfer_proxy"

if [[ "${SYSTEM}" -eq 1 ]]; then
	log "installing udev rule and systemd unit"
	install -D -m 0644 "${REPO_DIR}/packaging/udev/60-rk1808-npu.rules" \
		/etc/udev/rules.d/60-rk1808-npu.rules
	# the unit references the .deb path: point it to /usr/local instead
	install -d -m 0755 /etc/systemd/system
	sed 's#/usr/lib/slave-mobilenet-ssd/npu_transfer_proxy#/usr/local/bin/npu_transfer_proxy#' \
		"${REPO_DIR}/packaging/systemd/npu-transfer-proxy.service" \
		> /etc/systemd/system/npu-transfer-proxy.service
	chmod 0644 /etc/systemd/system/npu-transfer-proxy.service

	ldconfig
	udevadm control --reload-rules
	udevadm trigger --action=change --subsystem-match=usb --attr-match=idVendor=2207 || true
	systemctl daemon-reload
	systemctl enable --now npu-transfer-proxy.service
	log "done: systemctl status npu-transfer-proxy"
else
	log "done. Build with: cmake -S . -B build -DRKNN_SDK_DIR=${PREFIX} && cmake --build build"
fi
