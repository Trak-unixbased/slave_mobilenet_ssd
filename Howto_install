 *
 * The network runs on a Rockchip RK1808 USB compute stick in passive mode
 * (librknn_api + npu_transfer_proxy); capture, post-processing and display
 * run on the host (Raspberry Pi 5, Orange Pi 6 Plus, ...).
 */
#include <algorithm>
#include <cerrno>
#include <climits>
#include <cmath>
#include <csignal>
#include <cstdio>
#include <cstdlib>
#include <cstring>
